# PyKnora 环境变量示例。复制成 .env 后按需修改。
# 全部字段以 src/pyknora/core/settings.py 为准；这里只列会实际影响运行的那些。
# 注意：不配也能跑——每一项都有代码内默认值；下面写的就是默认值。

# ---------- 数据库 ----------
# 建表脚本靠 docker exec，所以容器名也要对得上
PYKNORA_DATABASE_URL=postgresql+asyncpg://postgres:dev@127.0.0.1:5433/pyknora
PYKNORA_DB_CONTAINER=pyknora-pg

# ---------- 鉴权（JWT）----------
# 注意：这一项**不在 Settings 里**，由 services/auth/jwt.py:37 直接读 os.environ。
# 因此它不会出现在 settings 对象上；漏配时用内置的 dev 默认值，生产必须换掉。
PYKNORA_JWT_SECRET=dev-only-insecure-secret
# 令牌有效期目前是 jwt.py 里的 DEFAULT_TTL_SECONDS=3600，尚未做成配置项

# ---------- Embedding（向量模型）----------
# 三选一：local / openai / hashing
#   local   = sentence-transformers 加载本地权重（需要 uv sync --extra local-embed，首次会下载模型）
#   openai  = 调 OpenAI 兼容的 /embeddings 接口
#   hashing = 确定性哈希假向量，不下载模型、不联网，仅用于测试与无外网环境
PYKNORA_EMBEDDING_BACKEND=local
# 下面这个只对 local 后端是权威；openai 后端看 PYKNORA_OPENAI_EMBEDDING_MODEL
PYKNORA_EMBEDDING_MODEL_KEY=BAAI/bge-small-zh-v1.5
# 硬约束：后端实际输出维度必须等于这个值，不等就抛 EmbeddingDimensionError，绝不截断
# （换 openai 的 text-embedding-3-small 是 1536 维，要么改这里，要么换模型）
PYKNORA_EMBEDDING_DIM=512
PYKNORA_EMBEDDING_BATCH_SIZE=8
PYKNORA_EMBEDDING_TIMEOUT_S=30
PYKNORA_HUGGINGFACE_ENDPOINT=https://huggingface.co
# 这两个除了给嵌入器自己用，还会写进 HF_ENDPOINT 环境变量（embedder.py:124-129），
# 所以对 sentence-transformers 的下载同样生效
PYKNORA_HUGGINGFACE_MIRROR=https://hf-mirror.com

# openai 后端专用
PYKNORA_OPENAI_BASE_URL=https://api.openai.com/v1
PYKNORA_OPENAI_API_KEY=
PYKNORA_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---------- 问答生成（chat）----------
# 这三个只管 /chat 的 LLM 调用；留空 PYKNORA_CHAT_API_KEY 时 /chat 直接 503
PYKNORA_CHAT_BASE_URL=https://api.openai.com/v1
PYKNORA_CHAT_API_KEY=
PYKNORA_CHAT_MODEL=gpt-4o-mini
PYKNORA_CHAT_TIMEOUT_S=60
PYKNORA_CHAT_MAX_CONTEXT_CHUNKS=6

# ---------- 切片 ----------
PYKNORA_CHUNK_SIZE=512
PYKNORA_CHUNK_OVERLAP=64

# ---------- 队列与租约 ----------
PYKNORA_LEASE_SECONDS=90
PYKNORA_MAX_ATTEMPTS=3

# ---------- 其他 ----------
PYKNORA_MAX_UPLOAD_BYTES=52428800
# 分页游标签名密钥：生产必须换掉，换了旧游标全部失效（CURSOR_EXPIRED 410）
PYKNORA_CURSOR_SECRET=dev-only-insecure-cursor-secret
PYKNORA_CURSOR_TTL_SECONDS=86400
